{
  "datasets": [
    {
      "name": "retail_metrics",
      "displayName": "Retail Metrics (INR)",
      "config": {
        "version": "1.1",
        "source": "retail_q.retail_semantic.retail_metrics",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "Total Revenue",
            "expr": "MEASURE(source.`Total Revenue`)",
            "format": {
              "type": "currency",
              "currencyCode": "INR",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              },
              "abbreviation": "compact"
            }
          },
          {
            "name": "Transaction Count",
            "expr": "MEASURE(source.`Transaction Count`)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              },
              "hideGroupSeparator": false
            }
          },
          {
            "name": "Total Quantity Sold",
            "expr": "MEASURE(source.`Total Quantity Sold`)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              },
              "hideGroupSeparator": false
            }
          },
          {
            "name": "Total Discount",
            "expr": "MEASURE(source.`Total Discount`)",
            "format": {
              "type": "currency",
              "currencyCode": "INR",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              },
              "abbreviation": "compact"
            }
          },
          {
            "name": "Average Transaction Value",
            "expr": "MEASURE(source.`Average Transaction Value`)",
            "format": {
              "type": "currency",
              "currencyCode": "INR",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              },
              "abbreviation": "compact"
            }
          },
          {
            "name": "Unique Customers",
            "expr": "MEASURE(source.`Unique Customers`)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              },
              "hideGroupSeparator": false
            }
          }
        ]
      }
    }
  ],
